# ---------------------------------------------------------------------------
# GameStats — copier ce fichier vers .env puis compléter les valeurs.
# ---------------------------------------------------------------------------

# Clé partagée entre le backend et l'agent Windows (obligatoire).
# Générer une valeur solide : openssl rand -hex 24
AGENT_API_KEY=change-me

# Fuseau horaire utilisé par le dashboard (heatmap, "aujourd'hui", etc.).
TIMEZONE=Europe/Paris

# --- Steam -----------------------------------------------------------------
# Clé API : https://steamcommunity.com/dev/apikey
# SteamID64 : https://steamid.io/ (le profil doit être public)
STEAM_API_KEY=
STEAM_ID=

# --- IGDB (jaquettes HD + genres) ------------------------------------------
# Créer une application Twitch puis récupérer les identifiants sur
# https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Xbox (connexion via Azure device code) --------------------------------
# Client ID d'une application Microsoft Entra publique avec Xbox Live sign-in.
# La connexion se fait ensuite depuis Paramètres > Intégrations > Xbox.
XBOX_CLIENT_ID=

# --- Réglages optionnels ---------------------------------------------------
# Les valeurs Steam / IGDB / clé agent servent d'amorçage : elles sont ensuite
# modifiables dans Paramètres > Intégrations depuis l'interface.
SESSION_DAYS=7
COOKIE_SECURE=false

# Ports exposés sur l'hôte (choisis pour éviter les ports 8000/8080 souvent pris).
FRONTEND_PORT=8090
BACKEND_PORT=8091

# Un heartbeat agent est considéré comme périmé après ce délai (secondes).
AGENT_STALE_SECONDS=180

# Fréquences des tâches de fond (minutes).
STEAM_SYNC_MINUTES=15
IGDB_SYNC_MINUTES=60
INFLUX_EXPORT_MINUTES=15
XBOX_SYNC_MINUTES=30
UBISOFT_SYNC_MINUTES=60
GOG_SYNC_MINUTES=60
EPIC_SYNC_MINUTES=120
METADATA_SYNC_MINUTES=360
METADATA_ENRICH_LIMIT=8
OPENCRITIC_ENRICH_LIMIT=4

# Mettre à false pour désactiver le planificateur (debug/tests).
SCHEDULER_ENABLED=true

# Niveau de log du backend.
LOG_LEVEL=INFO
